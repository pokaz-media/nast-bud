<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Drugi warunek chroni przed pętlą, gdyby TLS kończył się na proxy przed Apache.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Adresy podstron starego WordPressa -> sekcje nowej strony jednostronicowej.
# Flaga NE jest konieczna, inaczej Apache zakoduje "#" jako %23.
# Cele są pełnymi adresami https, bo przy ścieżce względnej Apache składa adres
# ze schematem http i przeglądarka wykonuje zbędny drugi skok.
RewriteRule ^oferta/?$                        https://nast-bud.pl/#oferta     [R=301,L,NE]
RewriteRule ^beton-towarowy/?$                https://nast-bud.pl/#oferta     [R=301,L,NE]
RewriteRule ^pompowanie-betonu/?$             https://nast-bud.pl/#oferta     [R=301,L,NE]
RewriteRule ^bloczki-betonowe-fundamentowe/?$ https://nast-bud.pl/#oferta     [R=301,L,NE]
RewriteRule ^realizacje/?$                    https://nast-bud.pl/#realizacje [R=301,L,NE]
RewriteRule ^certyfikaty/?$                   https://nast-bud.pl/#jakosc     [R=301,L,NE]
RewriteRule ^kontakt/?$                       https://nast-bud.pl/#kontakt    [R=301,L,NE]
RewriteRule ^firma/?$                         https://nast-bud.pl/            [R=301,L]
RewriteRule ^old/?$                           https://nast-bud.pl/            [R=301,L]
</IfModule>

# Nazwy plików nie zawierają hashy, więc CSS i JS cache'ujemy tylko na tydzień —
# przy dłuższym czasie poprawki nie dotarłyby do osób, które już odwiedziły stronę.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp A2592000
ExpiresByType image/png A2592000
ExpiresByType image/jpeg A2592000
ExpiresByType application/pdf A2592000
ExpiresByType text/css A604800
ExpiresByType text/javascript A604800
ExpiresByType text/html A3600
</IfModule>
